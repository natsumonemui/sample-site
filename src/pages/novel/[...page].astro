---
import type { GetStaticPaths } from "astro"
import MetaPage from "@/components/MetaPage.astro"
import PaginatedPostIndex from "@/components/PaginatedPostIndex.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"

type Props = {
  page: {
    data: Awaited<ReturnType<typeof getPosts<"novel">>>
    currentPage: number
    lastPage: number
  }
  allPosts: Awaited<ReturnType<typeof getPosts<"novel">>>
  allTags: string[]
  totalPosts: number
}

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts("novel")
  const allTags = Array.from(
    new Set(posts.flatMap((post) => post.data.tags ?? [])),
  ).sort((a, b) => a.localeCompare(b, "ja-JP"))

  const routes = paginate(posts, {
    pageSize: 10,
    props: {
      allPosts: posts,
      allTags,
      totalPosts: posts.length,
    },
  })

  return routes.slice(1).map((route, index) => ({
    params: {
      ...route.params,
      page: `page${index + 2}`,
    },
    props: route.props,
  }))
}) satisfies GetStaticPaths

const { page, allPosts, allTags, totalPosts } = Astro.props as Props
---

<Layout>
  <MetaPage slot="head" title="NOVEL" />
  <PaginatedPostIndex
    title="NOVEL"
    posts={page.data}
    allPosts={allPosts}
    allTags={allTags}
    totalPosts={totalPosts}
    basePath="novel"
    currentPage={page.currentPage}
    lastPage={page.lastPage}
  />
</Layout>