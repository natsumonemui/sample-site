---
import ArrowLeft from "@/assets/icons/arrow-left.svg"
import ArrowRight from "@/assets/icons/arrow-right.svg"
import type { CollectionEntry } from "astro:content"

type Post = CollectionEntry<"blog"> | CollectionEntry<"novel">
type Props = {
  prev?: Post
  next?: Post
  basePath?: "blog" | "novel"
}

const { prev, next, basePath = "blog" } = Astro.props
const hrefPrefix = basePath === "novel" ? "/novel" : "/blog"
---

<post-actions>
  <a
    href={prev && `${hrefPrefix}/${prev.id}`}
    data-icon-button
    data-dir="prev"
    aria-label={prev && `Previous post: ${prev.data.title}`}
    aria-hidden={!prev || undefined}
    title={prev?.data.title}
  >
    <ArrowLeft />
  </a>
  <a
    href={next && `${hrefPrefix}/${next.id}`}
    data-icon-button
    data-dir="next"
    aria-label={next && `Next post: ${next.data.title}`}
    aria-hidden={!next || undefined}
    title={next?.data.title}
  >
    <ArrowRight />
  </a>
</post-actions>

<style>
  post-actions {
    display: contents;

    @media (width < 64rem) {
      display: none;
    }
  }

  a {
    color: var(--foreground);

    &:not([href]) {
      color: var(--muted-foreground);
      opacity: 0.5;
      pointer-events: none;
    }
  }
</style>
