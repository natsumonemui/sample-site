---
type Props = {
  currentPage: number
  lastPage: number
  basePath: "blog" | "novel"
}

const { currentPage, lastPage, basePath } = Astro.props

const hrefFor = (pageNumber: number) =>
  pageNumber === 1 ? `/${basePath}/` : `/${basePath}/page${pageNumber}/`

const pages = Array.from({ length: lastPage }, (_, index) => index + 1)
const prevHref = currentPage > 1 ? hrefFor(currentPage - 1) : undefined
const nextHref = currentPage < lastPage ? hrefFor(currentPage + 1) : undefined
---

{
  lastPage > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {prevHref ? (
        <a class="pagination__link" href={prevHref} rel="prev" aria-label="Previous page">
          ←
        </a>
      ) : (
        <span class="pagination__link is-disabled" aria-hidden="true">←</span>
      )}

      <ol class="pagination__pages">
        {pages.map((pageNumber) => (
          <li>
            {pageNumber === currentPage ? (
              <span class="pagination__link is-active" aria-current="page">
                {pageNumber}
              </span>
            ) : (
              <a class="pagination__link" href={hrefFor(pageNumber)}>
                {pageNumber}
              </a>
            )}
          </li>
        ))}
      </ol>

      {nextHref ? (
        <a class="pagination__link" href={nextHref} rel="next" aria-label="Next page">
          →
        </a>
      ) : (
        <span class="pagination__link is-disabled" aria-hidden="true">→</span>
      )}
    </nav>
  )
}

<style is:global>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--space-m);
    padding-block: var(--space-xs);
  }

  .pagination__pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2rem;
    padding: 0.24rem 0.52rem;
    background: transparent;
    color: var(--muted-foreground);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-decoration: none;
    line-height: 1.4;
    transition:
      color 120ms,
      border-color 120ms;
  }

  .pagination__link:hover,
  .pagination__link.is-active {
    color: var(--destructive);
  }

  .pagination__link.is-disabled {
    opacity: 0.45;
  }

  @media (width < 40rem) {
    .pagination {
      gap: 0.35rem;
    }

    .pagination__pages {
      gap: 0.35rem;
    }
  }
</style>